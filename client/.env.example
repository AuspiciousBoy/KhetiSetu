# KhetiSetu Frontend Environment Variables
# Copy this file to .env.local or .env.production.local for local overrides.

# Backend API base URL (no trailing slash)
# For local development: leave empty (Vite proxy handles /api → localhost:5000)
# For Vercel deployment: set to your Render backend URL
# Example: VITE_API_URL=https://khetisetu-api.onrender.com
VITE_API_URL=
