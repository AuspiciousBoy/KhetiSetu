<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Your Order is Packed 📦 — {{orderId}}</title></head>
<body style="margin:0;padding:0;background-color:#ece8df;font-family:'Inter',Arial,sans-serif;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ece8df;padding:24px 0;">
  <tr><td align="center">
    <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background-color:#fdf9f0;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.08);">
      {{> header}}
      <tr><td style="background-color:#e8f5e9;padding:20px 32px;border-bottom:3px solid #2e7d32;">
        <p style="font-family:'Sora',Arial,sans-serif;font-size:11px;font-weight:600;color:#2e7d32;letter-spacing:1px;text-transform:uppercase;margin:0 0 4px 0;">📦 Packed & Ready for Dispatch</p>
        <h1 style="font-family:'Sora',Arial,sans-serif;font-size:20px;font-weight:700;color:#08241a;margin:0;">Order {{orderId}} is Packed</h1>
      </td></tr>
      <tr><td style="padding:28px 32px;">
        <p style="font-family:'Inter',Arial,sans-serif;font-size:14px;color:#3a3a3a;margin:0 0 20px 0;line-height:1.7;">
          Hello {{buyerName}}, the farmer has finished packing your fresh produce. It is now awaiting pickup by our logistics partner.
        </p>
        <div style="background-color:#f7f3ea;border-radius:6px;padding:16px;margin-bottom:20px;">
          <p style="font-family:'Sora',Arial,sans-serif;font-size:12px;font-weight:700;color:#5a5a5a;margin:0 0 6px 0;text-transform:uppercase;">Fulfillment Farm</p>
          <p style="font-family:'Inter',Arial,sans-serif;font-size:14px;font-weight:600;color:#08241a;margin:0;">{{farmName}}</p>
          <p style="font-family:'Inter',Arial,sans-serif;font-size:12px;color:#785838;margin:4px 0 0 0;">Estimated Delivery: {{dateFormat estimatedDelivery}}</p>
        </div>
        <table width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr><td align="center" style="padding:8px 0 16px 0;">
            <a href="{{trackingUrl}}" style="display:inline-block;background-color:#08241a;color:#ffffff;font-family:'Sora',Arial,sans-serif;font-size:14px;font-weight:600;text-decoration:none;padding:14px 32px;border-radius:6px;">View Delivery Tracking →</a>
          </td></tr>
        </table>
      </td></tr>
      {{> footer}}
    </table>
  </td></tr>
</table>
</body>
</html>
