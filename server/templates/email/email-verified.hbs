<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Email Verified ✓ — KhetiSetu</title></head>
<body style="margin:0;padding:0;background-color:#ece8df;font-family:'Inter',Arial,sans-serif;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ece8df;padding:24px 0;">
  <tr><td align="center">
    <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background-color:#fdf9f0;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.08);">
      {{> header}}
      <tr><td style="padding:36px 32px;text-align:center;">
        <div style="width:60px;height:60px;background-color:#e8f5e9;border-radius:50%;margin:0 auto 16px;line-height:60px;font-size:28px;">✓</div>
        <h1 style="font-family:'Sora',Arial,sans-serif;font-size:24px;font-weight:700;color:#08241a;margin:0 0 12px 0;">Email Successfully Verified!</h1>
        <p style="font-family:'Inter',Arial,sans-serif;font-size:14px;color:#3a3a3a;margin:0 0 24px 0;line-height:1.7;">
          Hello {{name}}, your email address has been verified. You now have full access to all KhetiSetu marketplace and agricultural intelligence features.
        </p>
        <table width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr><td align="center">
            <a href="{{loginUrl}}" style="display:inline-block;background-color:#08241a;color:#ffffff;font-family:'Sora',Arial,sans-serif;font-size:14px;font-weight:600;text-decoration:none;padding:14px 32px;border-radius:6px;">Go to Dashboard →</a>
          </td></tr>
        </table>
      </td></tr>
      {{> footer}}
    </table>
  </td></tr>
</table>
</body>
</html>
