<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>KhetiSetu Password Reset</title></head>
<body style="margin:0;padding:0;background-color:#ece8df;font-family:'Inter',Arial,sans-serif;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ece8df;padding:24px 0;">
  <tr><td align="center">
    <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background-color:#fdf9f0;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.08);">
      {{> header}}

      <tr><td style="padding:36px 32px;">
        <h1 style="font-family:'Sora',Arial,sans-serif;font-size:24px;font-weight:700;color:#08241a;margin:0 0 12px 0;">Reset Your Password</h1>
        <p style="font-family:'Inter',Arial,sans-serif;font-size:14px;color:#3a3a3a;margin:0 0 8px 0;line-height:1.7;">
          Hello {{name}}, we received a request to reset the password for your KhetiSetu account.
        </p>
        <p style="font-family:'Inter',Arial,sans-serif;font-size:14px;color:#3a3a3a;margin:0 0 24px 0;line-height:1.7;">
          Click the button below to set a new password. This link is valid for <strong>1 hour only</strong> and can be used once.
        </p>

        <table width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr><td align="center" style="padding:8px 0 24px 0;">
            <a href="{{resetUrl}}" style="display:inline-block;background-color:#ba1a1a;color:#ffffff;font-family:'Sora',Arial,sans-serif;font-size:15px;font-weight:600;text-decoration:none;padding:16px 40px;border-radius:6px;">Reset Password →</a>
          </td></tr>
        </table>

        <div style="background-color:#fff3e0;border:1px solid #e78353;border-radius:6px;padding:16px;margin-bottom:20px;">
          <p style="font-family:'Sora',Arial,sans-serif;font-size:12px;font-weight:700;color:#e65100;margin:0 0 6px 0;">⚠️ Security Notice</p>
          <p style="font-family:'Inter',Arial,sans-serif;font-size:12px;color:#5a5a5a;margin:0;line-height:1.5;">
            If you did not request a password reset, your account may be at risk. Please contact support immediately at <a href="mailto:{{supportEmail}}" style="color:#08241a;">{{supportEmail}}</a> and change your password.
          </p>
        </div>

        <div style="background-color:#f7f3ea;border-radius:6px;padding:16px;margin-bottom:20px;">
          <p style="font-family:'Sora',Arial,sans-serif;font-size:12px;font-weight:600;color:#5a5a5a;margin:0 0 6px 0;text-transform:uppercase;letter-spacing:0.5px;">Or copy this link:</p>
          <p style="font-family:'Inter',Arial,sans-serif;font-size:11px;color:#08241a;margin:0;word-break:break-all;">{{resetUrl}}</p>
        </div>

        <p style="font-family:'Inter',Arial,sans-serif;font-size:12px;color:#8a8a8a;margin:0;line-height:1.6;">
          This link expires in 1 hour. If you did not request this, you can safely ignore this email.
        </p>
      </td></tr>

      {{> footer}}
    </table>
  </td></tr>
</table>
</body>
</html>
