<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>[Action Required] Verify your KhetiSetu email</title></head>
<body style="margin:0;padding:0;background-color:#ece8df;font-family:'Inter',Arial,sans-serif;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ece8df;padding:24px 0;">
  <tr><td align="center">
    <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background-color:#fdf9f0;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.08);">
      {{> header}}

      <tr><td style="padding:36px 32px;">
        <h1 style="font-family:'Sora',Arial,sans-serif;font-size:24px;font-weight:700;color:#08241a;margin:0 0 12px 0;">Verify Your Email Address</h1>
        <p style="font-family:'Inter',Arial,sans-serif;font-size:14px;color:#3a3a3a;margin:0 0 20px 0;line-height:1.7;">
          Hello {{name}}, please verify your email address to activate your KhetiSetu account. This link expires in <strong>24 hours</strong>.
        </p>

        <table width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr><td align="center" style="padding:8px 0 24px 0;">
            <a href="{{verifyUrl}}" style="display:inline-block;background-color:#08241a;color:#ffffff;font-family:'Sora',Arial,sans-serif;font-size:15px;font-weight:600;text-decoration:none;padding:16px 40px;border-radius:6px;">✓ Verify Email Address</a>
          </td></tr>
        </table>

        <div style="background-color:#f7f3ea;border-radius:6px;padding:16px;margin-bottom:20px;">
          <p style="font-family:'Sora',Arial,sans-serif;font-size:12px;font-weight:600;color:#5a5a5a;margin:0 0 6px 0;text-transform:uppercase;letter-spacing:0.5px;">Button not working? Copy this link:</p>
          <p style="font-family:'Inter',Arial,sans-serif;font-size:11px;color:#08241a;margin:0;word-break:break-all;">{{verifyUrl}}</p>
        </div>

        <p style="font-family:'Inter',Arial,sans-serif;font-size:12px;color:#8a8a8a;margin:0;line-height:1.6;border-top:1px solid #e8e4da;padding-top:16px;">
          If you did not create a KhetiSetu account, you can safely ignore this email. This link will expire in 24 hours.
        </p>
      </td></tr>

      {{> footer}}
    </table>
  </td></tr>
</table>
</body>
</html>
