<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Password Changed — KhetiSetu</title></head>
<body style="margin:0;padding:0;background-color:#ece8df;font-family:'Inter',Arial,sans-serif;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ece8df;padding:24px 0;">
  <tr><td align="center">
    <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background-color:#fdf9f0;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.08);">
      {{> header}}
      <tr><td style="padding:36px 32px;">
        <div style="text-align:center;padding-bottom:20px;">
          <span style="font-size:40px;">🔐</span>
        </div>
        <h1 style="font-family:'Sora',Arial,sans-serif;font-size:22px;font-weight:700;color:#08241a;margin:0 0 12px 0;text-align:center;">Password Successfully Changed</h1>
        <p style="font-family:'Inter',Arial,sans-serif;font-size:14px;color:#3a3a3a;margin:0 0 20px 0;line-height:1.7;text-align:center;">
          Hello {{name}}, the password for your KhetiSetu account was changed on <strong>{{changedAt}}</strong>.
        </p>
        <div style="background-color:#e8f5e9;border:1px solid #2e7d32;border-radius:6px;padding:16px;margin-bottom:20px;text-align:center;">
          <p style="font-family:'Inter',Arial,sans-serif;font-size:13px;color:#2e7d32;margin:0;">✓ All active sessions have been logged out for your security.</p>
        </div>
        <div style="background-color:#fff3e0;border:1px solid #e78353;border-radius:6px;padding:16px;margin-bottom:20px;">
          <p style="font-family:'Sora',Arial,sans-serif;font-size:12px;font-weight:700;color:#e65100;margin:0 0 6px 0;">Wasn't you?</p>
          <p style="font-family:'Inter',Arial,sans-serif;font-size:12px;color:#5a5a5a;margin:0;line-height:1.5;">
            If you did not change your password, your account may be compromised. Contact us immediately at <a href="mailto:{{supportEmail}}" style="color:#08241a;">{{supportEmail}}</a>
          </p>
        </div>
        <table width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr><td align="center">
            <a href="{{loginUrl}}" style="display:inline-block;background-color:#08241a;color:#ffffff;font-family:'Sora',Arial,sans-serif;font-size:14px;font-weight:600;text-decoration:none;padding:14px 32px;border-radius:6px;">Log In with New Password</a>
          </td></tr>
        </table>
      </td></tr>
      {{> footer}}
    </table>
  </td></tr>
</table>
</body>
</html>
