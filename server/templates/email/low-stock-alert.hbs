<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>⚠️ Low Stock Alert — KhetiSetu</title></head>
<body style="margin:0;padding:0;background-color:#ece8df;font-family:'Inter',Arial,sans-serif;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ece8df;padding:24px 0;">
  <tr><td align="center">
    <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background-color:#fdf9f0;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.08);">
      {{> header}}
      <tr><td style="background-color:#fff3e0;padding:20px 32px;border-bottom:3px solid #e78353;">
        <p style="font-family:'Sora',Arial,sans-serif;font-size:11px;font-weight:600;color:#e65100;letter-spacing:1px;text-transform:uppercase;margin:0 0 4px 0;">⚠️ Low Stock Alert</p>
        <h1 style="font-family:'Sora',Arial,sans-serif;font-size:20px;font-weight:700;color:#08241a;margin:0;">Restock Required: {{listingTitle}}</h1>
      </td></tr>
      <tr><td style="padding:28px 32px;">
        <p style="font-family:'Inter',Arial,sans-serif;font-size:14px;color:#3a3a3a;margin:0 0 20px 0;line-height:1.7;">
          नमस्ते {{farmerName}}, your listing is running low on stock and may soon be unavailable to buyers.
        </p>
        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f7f3ea;border-radius:6px;margin-bottom:20px;">
          <tr>
            <td style="padding:20px;text-align:center;width:50%;border-right:1px solid #e8e4da;">
              <p style="font-family:'Sora',Arial,sans-serif;font-size:11px;font-weight:600;color:#5a5a5a;margin:0 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;">Remaining Stock</p>
              <p style="font-family:'Sora',Arial,sans-serif;font-size:30px;font-weight:700;color:#e65100;margin:0;">{{remainingQuantity}} {{unit}}</p>
            </td>
            <td style="padding:20px;text-align:center;width:50%;">
              <p style="font-family:'Sora',Arial,sans-serif;font-size:11px;font-weight:600;color:#5a5a5a;margin:0 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;">Original Stock</p>
              <p style="font-family:'Sora',Arial,sans-serif;font-size:30px;font-weight:700;color:#08241a;margin:0;">{{originalQuantity}} {{unit}}</p>
            </td>
          </tr>
        </table>
        <table width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr><td align="center" style="padding:8px 0 16px 0;">
            <a href="{{batchesUrl}}" style="display:inline-block;background-color:#08241a;color:#ffffff;font-family:'Sora',Arial,sans-serif;font-size:14px;font-weight:600;text-decoration:none;padding:14px 32px;border-radius:6px;">Register New Batch →</a>
          </td></tr>
        </table>
      </td></tr>
      {{> footer}}
    </table>
  </td></tr>
</table>
</body>
</html>
