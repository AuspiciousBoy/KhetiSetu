<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Order Cancelled — {{orderId}} — KhetiSetu</title></head>
<body style="margin:0;padding:0;background-color:#ece8df;font-family:'Inter',Arial,sans-serif;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ece8df;padding:24px 0;">
  <tr><td align="center">
    <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background-color:#fdf9f0;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.08);">
      {{> header}}
      <tr><td style="background-color:#fdecea;padding:20px 32px;border-bottom:3px solid #ba1a1a;">
        <p style="font-family:'Sora',Arial,sans-serif;font-size:11px;font-weight:600;color:#ba1a1a;letter-spacing:1px;text-transform:uppercase;margin:0 0 4px 0;">Order Cancelled</p>
        <h1 style="font-family:'Sora',Arial,sans-serif;font-size:20px;font-weight:700;color:#08241a;margin:0;">{{orderId}}</h1>
      </td></tr>
      <tr><td style="padding:28px 32px;">
        <p style="font-family:'Inter',Arial,sans-serif;font-size:14px;color:#3a3a3a;margin:0 0 16px 0;line-height:1.7;">
          Hello {{buyerName}}, your order has been cancelled.
        </p>
        {{#if reason}}
        <div style="background-color:#f7f3ea;border-radius:6px;padding:16px;margin-bottom:20px;border-left:3px solid #ba1a1a;">
          <p style="font-family:'Sora',Arial,sans-serif;font-size:12px;font-weight:700;color:#5a5a5a;margin:0 0 4px 0;text-transform:uppercase;letter-spacing:0.5px;">Reason</p>
          <p style="font-family:'Inter',Arial,sans-serif;font-size:13px;color:#3a3a3a;margin:0;">{{reason}}</p>
        </div>
        {{/if}}
        {{#if refundAmount}}
        <div style="background-color:#e8f5e9;border:1px solid #2e7d32;border-radius:6px;padding:16px;margin-bottom:20px;">
          <p style="font-family:'Sora',Arial,sans-serif;font-size:13px;font-weight:700;color:#2e7d32;margin:0 0 4px 0;">✓ Refund Initiated</p>
          <p style="font-family:'Inter',Arial,sans-serif;font-size:13px;color:#3a3a3a;margin:0;">{{inr refundAmount}} will be credited to your original payment method within 5-7 business days.</p>
        </div>
        {{/if}}
        <table width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr><td align="center" style="padding:8px 0 16px 0;">
            <a href="{{marketplaceUrl}}" style="display:inline-block;background-color:#08241a;color:#ffffff;font-family:'Sora',Arial,sans-serif;font-size:14px;font-weight:600;text-decoration:none;padding:14px 32px;border-radius:6px;">Browse Marketplace Again</a>
          </td></tr>
        </table>
      </td></tr>
      {{> footer}}
    </table>
  </td></tr>
</table>
</body>
</html>
