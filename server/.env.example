# ============================================================
# KhetiSetu - Server Environment Template
# ============================================================

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/khetisetu

# ============================================================
# GOOGLE GEMINI AI INTEGRATION (Farming Assistant & Quality Doctor)
# 1. Get your free API key at: https://aistudio.google.com/app/apikey
# 2. Paste your Gemini API key below:
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# LIVE WEATHER REPORT API (OpenWeatherMap / WeatherAPI)
# 1. OpenWeatherMap: https://openweathermap.org/api (Free)
# 2. WeatherAPI: https://www.weatherapi.com/ (Free)
# ============================================================
WEATHER_API_KEY=your_weather_api_key_here

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

STORAGE_BUCKET=khetisetu-produce-storage
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=local_storage_key
STORAGE_SECRET_KEY=local_storage_secret
UPLOAD_DIR=./uploads

LOG_LEVEL=debug

EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
