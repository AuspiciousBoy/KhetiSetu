# ============================================================
# KhetiSetu - Environment Configuration Template
# ============================================================

# Application Environment (development | test | staging | production)
NODE_ENV=development
PORT=5000

# Database Connection (MongoDB Atlas or local replica set)
MONGO_URI=mongodb://127.0.0.1:27017/khetisetu

# ============================================================
# GOOGLE GEMINI AI INTEGRATION (Farming Assistant & Quality Doctor)
# 1. Get your free API key at: https://aistudio.google.com/app/apikey
# 2. Paste your Gemini API key below:
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# LIVE WEATHER REPORT API (OpenWeatherMap / WeatherAPI)
# 1. OpenWeatherMap: https://openweathermap.org/api (Free)
# 2. WeatherAPI: https://www.weatherapi.com/ (Free)
# ============================================================
WEATHER_API_KEY=your_weather_api_key_here

# Authentication Secrets (Must be at least 64 random characters in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_64_chars_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_64_chars_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend & CORS Configuration (comma-separated origins allowed in backend)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secure Storage (AWS S3 / Cloudflare R2 / MinIO for image uploads)
STORAGE_BUCKET=khetisetu-produce-storage
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
UPLOAD_DIR=./uploads

# Logging & Monitoring
LOG_LEVEL=info

# ============================================================
# Email Service (Standard SMTP / Gmail / Mailtrap)
# 1. To use Gmail: Generate a 16-character App Password at:
#    https://myaccount.google.com/apppasswords
# 2. Paste your Gmail address in SMTP_USER and App Password in SMTP_PASS
# 3. Set EMAIL_ENABLED=true (or supplying credentials enables it automatically)
# ============================================================
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=KhetiSetu <your_email@gmail.com>
