# ============================================================
# KhetiSetu - Environment Configuration Template
# ============================================================

# Application Environment (development | test | staging | production)
NODE_ENV=development
PORT=5000

# Database Connection (MongoDB Atlas or local replica set)
MONGO_URI=mongodb://127.0.0.1:27017/khetisetu

# Authentication Secrets (Must be at least 64 random characters in production)
JWT_ACCESS_SECRET=khetisetu_dev_access_secret_super_secure_key_change_in_production_min64_chars!
JWT_REFRESH_SECRET=khetisetu_dev_refresh_secret_super_secure_key_change_in_production_min64_chars!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google Gemini API (Free Tier key for backend AI service - NEVER EXPOSE TO CLIENT)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend & CORS Configuration (comma-separated origins allowed in backend)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secure Storage (AWS S3 / Cloudflare R2 / MinIO for image uploads)
STORAGE_BUCKET=khetisetu-produce-storage
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
UPLOAD_DIR=./uploads

# Payment Gateway (Mock / Razorpay / Stripe tokenized payments)
PAYMENT_KEY_ID=rzp_test_placeholder
PAYMENT_SECRET=your_payment_secret
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret

# Logging & Monitoring
LOG_LEVEL=info

# ============================================================
# Email Service (Standard SMTP for Testing)
# ============================================================
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password



