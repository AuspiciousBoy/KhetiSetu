# ============================================================
# KhetiSetu - Environment Configuration Template
# ============================================================

# Application Environment (development | test | staging | production)
NODE_ENV=development
PORT=5000

# Database Connection (MongoDB Atlas or local replica set)
MONGO_URI=mongodb://127.0.0.1:27017/khetisetu

# Authentication Secrets (Must be at least 64 random characters in production)
JWT_ACCESS_SECRET=khetisetu_dev_access_secret_super_secure_key_change_in_production_min64_chars!
JWT_REFRESH_SECRET=khetisetu_dev_refresh_secret_super_secure_key_change_in_production_min64_chars!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google Gemini API (Free Tier key for backend AI service - NEVER EXPOSE TO CLIENT)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend & CORS Configuration (comma-separated origins allowed in backend)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secure Storage (AWS S3 / Cloudflare R2 / MinIO for image uploads)
STORAGE_BUCKET=khetisetu-produce-storage
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
UPLOAD_DIR=./uploads

# Payment Gateway (Mock / Razorpay / Stripe tokenized payments)
PAYMENT_KEY_ID=rzp_test_placeholder
PAYMENT_SECRET=your_payment_secret
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret

# Logging & Monitoring
LOG_LEVEL=info

# ============================================================
# Transactional Email: Nodemailer + Gmail OAuth2 (Primary)
# ============================================================
# Enable or disable transactional emails (true | false)
EMAIL_ENABLED=true
SMTP_PROVIDER=gmail_oauth2

# Gmail account address used for sending
GMAIL_USER=your_khetisetu_account@gmail.com
EMAIL_FROM_NAME=KhetiSetu
EMAIL_REPLY_TO=support@khetisetu.in
ADMIN_EMAIL=admin@khetisetu.in

# Google Cloud OAuth2 Credentials for Gmail API / SMTP
# 1. Enable Gmail API in Google Cloud Console
# 2. Create OAuth 2.0 Client ID (Web Application or Desktop)
# 3. Obtain Refresh Token via OAuth2 Playground (https://developers.google.com/oauthplayground)
#    with scope: https://mail.google.com/
GMAIL_CLIENT_ID=your_oauth2_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-your_oauth2_client_secret
GMAIL_REFRESH_TOKEN=1//your_long_lived_refresh_token
GMAIL_ACCESS_TOKEN=

# Standard SMTP / App Password fallback (when OAuth2 is not yet configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_khetisetu_account@gmail.com
SMTP_PASS=your_16_digit_app_password
EMAIL_DEBUG_OVERRIDE=


